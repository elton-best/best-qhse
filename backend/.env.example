APP_NAME=Laravel
APP_ENV=local
APP_KEY=

# Supervision Best Expert Group (connecteur)
SUPERVISION_PROJECT_CODE=BESTQHSE
SUPERVISION_SECRET=
SUPERVISION_ENDPOINT=http://127.0.0.1:8000
SUPERVISION_ENABLED=true
# Secret partagé HMAC pour le suivi du temps de travail (work sessions)
SUPERVISION_API_TOKEN=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Frontend React (pnpm dev) — utilisé pour les liens password-reset / vérification email.
FRONTEND_URL=http://localhost:8080
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-2

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,supervision
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# HttpOnly auth token cookie (progressive migration from localStorage)
AUTH_TOKEN_COOKIE_NAME=auth_token
AUTH_TOKEN_COOKIE_DOMAIN=null
AUTH_TOKEN_COOKIE_SECURE=true
AUTH_TOKEN_COOKIE_SAME_SITE=lax

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://logiqual-qms.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
