{
  "name": "frontend",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run build-only",
    "build:strict": "npm run type-check && npm run build-only",
    "preview": "vite preview",
    "build-only": "node --max-old-space-size=6144 ./node_modules/vite/bin/vite.js build",
    "type-check": "node --max-old-space-size=6144 ./node_modules/vue-tsc/bin/vue-tsc.js --noEmit -p tsconfig.app.json",
    "lint": "eslint . --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "cypress open",
    "test:e2e:headless": "cypress run",
    "check:migration": "bash ./scripts/check-migration-guards.sh"
  },
  "dependencies": {
    "@fontsource/roboto": "5.2.7",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/list": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@fullcalendar/vue3": "^6.1.20",
    "@headlessui/vue": "^1.7.23",
    "@mdi/font": "7.4.47",
    "@tiptap/extension-collaboration": "^3.18.0",
    "@tiptap/starter-kit": "^3.18.0",
    "@tiptap/vue-3": "^3.18.0",
    "@vuepic/vue-datepicker": "^12.1.0",
    "@vueup/vue-quill": "^1.2.0",
    "apexcharts": "^5.3.6",
    "axios": "^1.13.2",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.19",
    "echarts": "^6.0.0",
    "laravel-echo": "^2.3.0",
    "lucide-vue-next": "^0.562.0",
    "pinia": "^3.0.3",
    "pusher-js": "^8.4.0",
    "radix-vue": "^1.9.17",
    "tailwind-merge": "^3.4.0",
    "vue": "^3.5.21",
    "vue-chartjs": "^5.3.3",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.5.1",
    "vue-toastification": "^2.0.0-rc.5",
    "vue3-apexcharts": "^1.10.0",
    "vuedraggable": "^4.1.0",
    "vuetify": "^3.10.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/ui": "^4.0.17",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.23",
    "cypress": "^15.9.0",
    "eslint": "^9.35.0",
    "eslint-config-vuetify": "^4.2.0",
    "happy-dom": "^20.3.4",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.6",
    "sass-embedded": "^1.92.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.2",
    "unplugin-auto-import": "^20.1.0",
    "unplugin-fonts": "^1.4.0",
    "unplugin-vue-components": "^29.0.0",
    "unplugin-vue-router": "^0.15.0",
    "vite": "^7.1.5",
    "vite-plugin-vue-layouts-next": "^1.0.0",
    "vite-plugin-vuetify": "^2.1.2",
    "vitest": "^4.0.17",
    "vue-tsc": "^3.2.0"
  }
}
